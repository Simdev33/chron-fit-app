# Server-only secret. Never prefix this with EXPO_PUBLIC_.
GEMINI_API_KEY=replace-with-a-new-google-ai-studio-key

# Public URL of the deployed Expo server, required by native production builds.
EXPO_PUBLIC_API_URL=https://your-crohnsync-domain.example

# Supabase — az anon kulcs szándékosan publikus, RLS védi.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Fiókok. Mindkettő szerveroldali titok — SOHA ne kapjanak EXPO_PUBLIC_ előtagot.
# A service role kulcs megkerüli az RLS-t, ezért csak az API útvonalak látják.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Resend → API Keys
RESEND_API_KEY=
# Feladó. A domainnek hitelesítettnek kell lennie a Resendnél, különben
# csak a fiók saját címére megy ki levél.
RESEND_FROM=CrohnSync <noreply@sajatdomain.hu>
