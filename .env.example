# Server-only secret. Never prefix this with EXPO_PUBLIC_.
GEMINI_API_KEY=replace-with-a-new-google-ai-studio-key

# Public URL of the deployed Expo server, required by native production builds.
EXPO_PUBLIC_API_URL=https://your-crohnsync-domain.example

# Supabase — az anon kulcs szándékosan publikus, RLS védi.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
